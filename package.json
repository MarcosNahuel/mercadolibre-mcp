{
  "name": "@nahuelalbornoz/mercadolibre-mcp",
  "version": "1.2.0-alpha.2",
  "description": "Mercado Libre MCP server for Claude Code, Cursor and AI agents: seller API tools for products, orders, price/stock, questions, ads and reputation (write-back) + official MCP proxy + Supabase token store + TRAID knowledge tools.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mercadolibre-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:knowledge": "python ../CONOCIMIENTO-NAHUEL/scripts/build_knowledge_snapshot.py --knowledge-root ../CONOCIMIENTO-NAHUEL --output ./data/knowledge.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "prepublishOnly": "npm run build:knowledge && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@supabase/supabase-js": "^2.106.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mercadolibre",
    "mercado-libre",
    "mercadolivre",
    "seller-api",
    "ecommerce",
    "latam",
    "argentina",
    "mexico",
    "brasil",
    "claude",
    "claude-code",
    "cursor",
    "anthropic",
    "ai",
    "agent",
    "supabase",
    "write-back",
    "knowledge-server",
    "traid",
    "context-engineering"
  ],
  "author": "TRAID Agency <contacto@traid.agency>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcosNahuel/mercadolibre-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MarcosNahuel/mercadolibre-mcp/issues"
  },
  "homepage": "https://github.com/MarcosNahuel/mercadolibre-mcp#readme"
}
